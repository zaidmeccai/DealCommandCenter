# Salesforce Credentials
SALESFORCE_USERNAME=your_email@company.com
SALESFORCE_PASSWORD=your_password
SALESFORCE_SECURITY_TOKEN=your_security_token
# Optional: use a custom domain (e.g., mycompany.my.salesforce.com)
# SALESFORCE_DOMAIN=login

# Avoma API
AVOMA_API_KEY=your_avoma_api_key

# Anthropic (Claude) API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Your Salesforce User ID or email (to filter opportunities owned by you)
MY_SALESFORCE_EMAIL=your_email@company.com
