[Unit]
Description=Deal Command Center Web Dashboard
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/deal-command-center
ExecStart=/opt/deal-command-center/.venv/bin/gunicorn \
    --bind 0.0.0.0:5000 \
    --workers 2 \
    --timeout 120 \
    "deal_command_center.web:create_app()"
EnvironmentFile=/opt/deal-command-center/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
